# ============================================================================
# APPLICATION CORE
# ============================================================================
APP_NAME="Sitiame Capitale"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ============================================================================
# ADMINISTRATION PLATFORME
# ============================================================================
# Email du compte qui reçoit le rôle « administrateur plateforme » au seed
# Laisser vide pour ne promouvoir personne automatiquement
# Commandes admin : php artisan platform:create-admin email@exemple.com
#                php artisan platform:grant-admin email@exemple.com
#                php artisan platform:set-password email@exemple.com
PLATFORM_ADMIN_EMAIL=

# ============================================================================
# LOCALISATION
# ============================================================================
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

# ============================================================================
# MAINTENANCE
# ============================================================================
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ============================================================================
# SÉCURITÉ
# ============================================================================
BCRYPT_ROUNDS=12

# ============================================================================
# LOGGING
# ============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Journal des actions menu (storage/logs/menu-actions-*.log)
LOG_MENU_ACTIONS=true
LOG_MENU_ACTIONS_DAYS=90

# Configuration des logs spécialisés (jours de rétention)
LOG_OCR_DAYS=30
LOG_EMAIL_DAYS=30
LOG_UPLOADS_DAYS=30
LOG_API_DAYS=30
LOG_EXCEPTIONS_DAYS=30
LOG_QUEUE_DAYS=30
LOG_FINANCIAL_AUDIT_DAYS=180

# ============================================================================
# BASE DE DONNÉES
# ============================================================================
# SQLite par défaut pour développement. Pour production, utilisez PostgreSQL/MySQL
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ============================================================================
# SESSION & CACHE
# ============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

# ============================================================================
# FILESYSTEM & QUEUE
# ============================================================================
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================================================
# REDIS (optionnel)
# ============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================================
# MEMCACHED (optionnel)
# ============================================================================
MEMCACHED_HOST=127.0.0.1

# ============================================================================
# EMAIL
# ============================================================================
# En développement : utilise 'log' pour voir les emails dans storage/logs
# En production : utilise 'smtp' avec configuration SMTP réelle
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sitiame-capital.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# RECAPTCHA (optionnel)
# ============================================================================
# Laisser vide pour désactiver la vérification Recaptcha
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ============================================================================
# PAIEMENTS - FEDAPAY SANDBOX
# ============================================================================
# Désactivé par défaut. Activez FEDAPAY_SANDBOX_ENABLED=true et configurez les clés
FEDAPAY_SANDBOX_ENABLED=false
FEDAPAY_SANDBOX_BASE_URL=https://sandbox-api.fedapay.com
FEDAPAY_SANDBOX_API_KEY=
FEDAPAY_SANDBOX_PUBLIC_KEY=
FEDAPAY_SANDBOX_PAYMENT_PAGE_URL=
FEDAPAY_SANDBOX_PAYMENT_PAGE_NAME="Page de paiement FedaPay"
FEDAPAY_SANDBOX_PAYMENT_PAGE_AMOUNT=15000
FEDAPAY_SANDBOX_PAYMENT_PAGE_CURRENCY=CFA
FEDAPAY_SANDBOX_PAYMENT_PAGE_METHOD=WAVE
FEDAPAY_SANDBOX_PAYMENT_PAGE_COUNTRY=CIV
FEDAPAY_SANDBOX_FALLBACK_TO_PAYMENT_PAGE=true
FEDAPAY_SANDBOX_MOBILE_METHODS=WAVE,MTN_MOMO,ORANGE_MONEY,MOOV_MONEY,CELTIIS_MONEY,FLOOZ

# ============================================================================
# PAIEMENTS - CINETPAY
# ============================================================================
# Désactivé par défaut. Activez CINETPAY_ENABLED=true et configurez les clés
# Documentation : https://panel.cinetpay.net/sitiame-capital/developer/documentation
CINETPAY_ENABLED=false
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_CHECKOUT_URL=https://api-checkout.cinetpay.com/v2/payment
CINETPAY_CHECK_URL=https://api-checkout.cinetpay.com/v2/payment/check
CINETPAY_CURRENCY=XOF
CINETPAY_CHANNELS=ALL
CINETPAY_LANG=fr
CINETPAY_SUBSCRIPTION_AMOUNT=15000
CINETPAY_PREMIUM_DAYS=30
CINETPAY_CUSTOMER_COUNTRY=CI
CINETPAY_TIMEOUT=30
CINETPAY_SIMULATE_WHEN_UNCONFIGURED=true
CINETPAY_MOBILE_METHODS=MOBILE_MONEY,WAVE,ORANGE_MONEY,MTN_MOMO,MOOV_MONEY,CREDIT_CARD

# ============================================================================
# PAIEMENTS - STRIPE
# ============================================================================
# Désactivé par défaut. Activez STRIPE_ENABLED=true et configurez les clés
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=XOF
STRIPE_PAYOUT_CURRENCY=XOF
STRIPE_PAYMENT_LINK_URL=

# ============================================================================
# OCR - PADDLEOCR (optionnel)
# ============================================================================
# Désactivé par défaut. Nécessite Python et dépendances PaddleOCR
# Le système utilise l'extraction Excel native par défaut
PADDLE_OCR_ENABLED=false
PADDLE_OCR_PYTHON_PATH=python
PADDLE_OCR_RUNNER_PATH=paddle_ocr_runner.py
PADDLE_OCR_TIMEOUT=180
PADDLE_OCR_PREFERRED_DEVICE=gpu
PADDLE_OCR_FALLBACK_TO_CPU=true
PADDLE_OCR_PAGE_NUM=0
PADDLE_OCR_LANGUAGE=fr
PADDLE_OCR_MAX_FILE_SIZE_KB=20480

# ============================================================================
# ASSISTANT IA - GOOGLE GEMINI & HUGGING FACE
# ============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=45

HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TIMEOUT=45

# ============================================================================
# STOCKAGE CLOUD - AWS S3 (optionnel)
# ============================================================================
# Désactivé par défaut. Utilise storage local par défaut
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# LICENCES ENTREPRISE
# ============================================================================
# Nombre de sièges utilisateurs par licence entreprise (défaut 3)
ENTERPRISE_LICENSE_MAX_USERS=3

# ============================================================================
# FRONTEND
# ============================================================================
VITE_APP_NAME="${APP_NAME}"
