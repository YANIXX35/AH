APP_NAME="Sitiame Capitale"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# E-mail du compte qui reçoit le rôle « administrateur plateforme » au seed (php artisan db:seed).
# Laisser vide pour ne promouvoir personne automatiquement. Créer un admin : php artisan platform:create-admin email@exemple.com
# Promouvoir un compte existant : php artisan platform:grant-admin email@exemple.com
# Changer le mot de passe : php artisan platform:set-password email@exemple.com
PLATFORM_ADMIN_EMAIL=admin@example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Journaliser les visites / actions sur les routes du menu (storage/logs/menu-actions-*.log)
LOG_MENU_ACTIONS=true
LOG_MENU_ACTIONS_DAYS=90

# Nombre de sièges utilisateurs par licence entreprise (pack multi-comptes, défaut 3).
ENTERPRISE_LICENSE_MAX_USERS=3

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.sitiame-capital.com
MAIL_PORT=587
MAIL_USERNAME=contact@sitiame-capital.com
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="contact@sitiame-capital.com"
MAIL_FROM_NAME="${APP_NAME}"

RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

FEDAPAY_SANDBOX_ENABLED=true
FEDAPAY_SANDBOX_BASE_URL=https://sandbox-api.fedapay.com
FEDAPAY_SANDBOX_API_KEY=your-fedapay-sandbox-api-key
FEDAPAY_SANDBOX_PUBLIC_KEY=your-fedapay-sandbox-public-key
FEDAPAY_SANDBOX_PAYMENT_PAGE_URL=https://sandbox-me.fedapay.com/89Y1fLZb
FEDAPAY_SANDBOX_PAYMENT_PAGE_NAME="Votre page de paiement"
FEDAPAY_SANDBOX_PAYMENT_PAGE_AMOUNT=15000
FEDAPAY_SANDBOX_PAYMENT_PAGE_CURRENCY=CFA
FEDAPAY_SANDBOX_PAYMENT_PAGE_METHOD=WAVE
FEDAPAY_SANDBOX_PAYMENT_PAGE_COUNTRY=CIV
FEDAPAY_SANDBOX_FALLBACK_TO_PAYMENT_PAGE=true
FEDAPAY_SANDBOX_MOBILE_METHODS=WAVE,MTN_MOMO,ORANGE_MONEY,MOOV_MONEY,CELTIIS_MONEY,FLOOZ

# CinetPay — doc : https://panel.cinetpay.net/sitiame-capital/developer/documentation?doc=overview
CINETPAY_ENABLED=true
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_SECRET_KEY=your-cinetpay-secret-key
CINETPAY_CHECKOUT_URL=https://api-checkout.cinetpay.com/v2/payment
CINETPAY_CHECK_URL=https://api-checkout.cinetpay.com/v2/payment/check
CINETPAY_CURRENCY=XOF
CINETPAY_CHANNELS=ALL
CINETPAY_LANG=fr
CINETPAY_SUBSCRIPTION_AMOUNT=15000
CINETPAY_PREMIUM_DAYS=30
CINETPAY_CUSTOMER_COUNTRY=CI
CINETPAY_TIMEOUT=30
CINETPAY_SIMULATE_WHEN_UNCONFIGURED=true
CINETPAY_MOBILE_METHODS=MOBILE_MONEY,WAVE,ORANGE_MONEY,MTN_MOMO,MOOV_MONEY,CREDIT_CARD

PADDLE_OCR_ENABLED=false
PADDLE_OCR_PYTHON_PATH=python
PADDLE_OCR_RUNNER_PATH=C:\application\paddle_ocr_runner.py
PADDLE_OCR_TIMEOUT=180
PADDLE_OCR_PREFERRED_DEVICE=gpu
PADDLE_OCR_FALLBACK_TO_CPU=true
PADDLE_OCR_PAGE_NUM=0
PADDLE_OCR_LANGUAGE=fr
PADDLE_OCR_MAX_FILE_SIZE_KB=20480

STRIPE_ENABLED=false
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=XOF
STRIPE_PAYOUT_CURRENCY=XOF
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_xxxxxxxxxxxxx

# Assistant IA (Hugging Face)
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TIMEOUT=45

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
