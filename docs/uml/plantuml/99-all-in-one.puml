@startuml seq_accounting_upload_documents__all
title Séquence — Import de documents comptables (POST /accounting/documents)

actor Utilisateur as U
participant "AccountingController" as AC
participant "OcrPipelineService" as PIPE
participant "OcrService" as OCR
database "accounting_documents" as AD
database "accounting_entries" as AE
participant "Storage (public)" as FS

U -> AC : POST /accounting/documents (documents[])
AC -> AC : validate(mimes, max)

loop chaque fichier
  AC -> AD : check doublon (sha1)
  alt doublon
    note over AC : ignoré
  else
    AC -> FS : store()
    AC -> PIPE : processStoredDocument()
    PIPE --> AC : ocr_result + confidence + review_required
    alt OCR success
      AC -> OCR : verifyCompleteDocument()
      AC -> AD : create(status=validated|pending_validation)
      alt auto-validé
        AC -> AE : createEntryFromAutoValidatedDocument()
      end
    else OCR failed
      AC -> AD : create(status=ocr_failed)
    end
  end
end

AC --> U : Redirect /accounting/documents

@enduml

