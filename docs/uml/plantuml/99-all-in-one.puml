@startuml seq_auth_login__all
title Séquence — Connexion (login) + contrôles (reCAPTCHA / suspension / FIRD)

actor Visiteur as V
participant "AuthController" as AC
participant "reCAPTCHA" as RC
participant "Auth (session)" as AUTH
database "users" as UDB

V -> AC : POST /login (email, password, remember, g-recaptcha-response)
AC -> RC : verifyRecaptcha(token, ip)

alt reCAPTCHA invalide
  AC --> V : Erreur (login.email)\nValidation reCAPTCHA échouée
else reCAPTCHA OK
  AC -> AUTH : Auth::attempt(email, password, remember)
  alt identifiants invalides
    AC --> V : Erreur (login.email)\nIdentifiants invalides
  else authentifié
    AC -> AUTH : session()->regenerate()
    AC -> UDB : Charger User (request->user)
    alt compte suspendu
      AC -> AUTH : logout + invalidate session
      AC --> V : Erreur (login.email)\nCompte suspendu
    else compte actif
      AC -> UDB : Vérifier champs FIRD
      alt FIRD incomplet (hors admin/comptable)
        AC --> V : Redirect /profile/entreprise/fird\n(status: compléter FIRD)
      else OK
        AC --> V : Redirect intended /dashboard
      end
    end
  end
end

@enduml

@startuml seq_auth_password_reset_otp__all
title Séquence — Réinitialisation mot de passe (OTP)

actor Utilisateur as U
participant "AuthController" as AC
database "password_reset_otps" as OTP
participant "Mail (PasswordResetOtpMail)" as MAIL1
participant "Mail (PasswordResetConfirmedMail)" as MAIL2
database "users" as UDB

U -> AC : POST /forgot-password (email)
AC -> UDB : Rechercher User par email

alt email inconnu
  AC --> U : Redirect /reset-password?email=...\n(status: "Si l'adresse existe...")
else email connu
  AC -> OTP : Vérifier cooldown (dernier OTP < 60s ?)
  alt cooldown actif
    AC --> U : Redirect /reset-password?email=...\n(erreur: patienter)
  else OK
    AC -> OTP : delete(email) + insert(otp_hash, expires_at=+10min, attempts=0)
    AC -> MAIL1 : envoyer OTP
    alt échec mail
      AC -> OTP : delete(email)
      AC --> U : Erreur (email)\nImpossible d'envoyer OTP
    else mail envoyé
      AC --> U : Redirect /reset-password?email=...\n(status: OTP envoyé)
    end
  end
end

== Validation OTP ==

U -> AC : POST /reset-password (email, otp, password, password_confirmation)
AC -> OTP : Lire record + vérifier expires_at

alt record absent/expiré
  AC --> U : Erreur (otp)\nOTP invalide ou expiré
else record présent
  AC -> OTP : Vérifier attempts (< 5)
  alt trop de tentatives
    AC --> U : Erreur (otp)\nTrop de tentatives
  else tentatives OK
    AC -> OTP : Comparer hash OTP
    alt OTP incorrect
      AC -> OTP : attempts++
      AC --> U : Erreur (otp)\nOTP incorrect
    else OTP valide
      AC -> UDB : Charger User + update(password hash)
      AC -> OTP : delete(email)
      AC -> MAIL2 : envoyer confirmation (best effort)
      AC --> U : Redirect /login\n(status: mot de passe réinitialisé)
    end
  end
end

@enduml

@startuml seq_profile_update__all
title Séquence — Mise à jour du profil (POST /profile)

actor Utilisateur as U
participant "Route closure (routes/web.php)" as ROUTE
participant "Validation Request" as VAL
participant "Storage::disk(public)" as FS
database "users" as UDB

U -> ROUTE : POST /profile (...)
ROUTE -> VAL : validate(...) + règles (locale: fr/en, currency: XOF/EUR/USD)

alt company_logo upload
  ROUTE -> FS : delete ancien logo
  ROUTE -> FS : store('company-logos')
end

alt avatar upload
  ROUTE -> FS : delete ancien avatar
  ROUTE -> FS : store('avatars')
end

alt password fourni
  ROUTE -> UDB : Hash::make(password)
else password vide
  note over ROUTE : password retiré du payload
end

ROUTE -> UDB : user->update(validated)
ROUTE --> U : back(status: Profil mis à jour)

@enduml

@startuml seq_profile_subscription_simulate__all
title Séquence — Simulation d'abonnement (POST /profile/subscription/simulate)

actor Utilisateur as U
participant "Route closure (routes/web.php)" as ROUTE
participant "Validation Request" as VAL
database "users" as UDB
database "subscription_histories" as SH

U -> ROUTE : POST /profile/subscription/simulate
ROUTE -> UDB : Charger user

alt user is_platform_admin
  ROUTE --> U : back(erreur: admins non concernés)
else compte entreprise
  ROUTE -> VAL : validate(plan_type, duration_days)
  alt plan_type=free
    ROUTE -> UDB : update(...) + SH::create(to_status=free)
  else plan_type=trial
    ROUTE -> UDB : update(...) + SH::create(to_status=trialing)
  else plan_type=premium
    ROUTE -> UDB : update(...) + SH::create(to_status=active)
  end
  ROUTE --> U : back(status: simulation appliquée)
end

@enduml

@startuml seq_profile_team_add_member__all
title Séquence — Équipe entreprise : ajout d'un collègue (POST /profile/equipe)

actor "Inviteur (compte entreprise Premium)" as I
participant "EnterpriseTeamController" as ETC
participant "Validation Request" as VAL
database "enterprise_licenses" as LIC
database "users" as UDB

I -> ETC : POST /profile/equipe (name, email, password...)
ETC -> ETC : authorizeEnterpriseInviter(inviter)
ETC -> VAL : validate(name, email unique, password confirmed)

ETC -> LIC : lockForUpdate(license)
alt licence non usable
  ETC --> I : Erreur (email)\nLicence invalide
else siège disponible ?
  alt aucun siège
    ETC --> I : Erreur (email)\nMax seats atteint
  else OK
    ETC -> UDB : User::create(...)\nenterprise_license_id=license.id
